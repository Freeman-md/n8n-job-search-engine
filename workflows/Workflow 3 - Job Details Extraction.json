        "jsCode": "// Ensure the model response completed successfully\n\nconst response = $input.first().json.output[0];\n\nif (!response) {\n  throw new Error(\"AI response missing output array.\");\n}\n\nif (response.status !== \"completed\") {\n  throw new Error(`AI response status invalid. Expected \"completed\" but got \"${response.status}\".`);\n}\n\nconst content = response.content?.[0];\n\nif (!content || !content.text) {\n  throw new Error(\"AI response missing text payload.\");\n}\n\n// Return only the structured job object\nreturn [\n  {\n    json: content.text\n  }\n];"
