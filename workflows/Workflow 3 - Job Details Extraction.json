    {
      "parameters": {
        "jsCode": "// ---------- Helpers ----------\n\nfunction isObject(value) {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\n\nfunction formatHeading(key) {\n  return key.replace(/_/g, \" \").toUpperCase();\n}\n\nfunction formatValue(value, indentationLevel = 0) {\n  const indent = \"  \".repeat(indentationLevel);\n  let output = \"\";\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      if (isObject(item)) {\n        output += formatValue(item, indentationLevel);\n      } else {\n        output += `${indent}- ${item}\\n`;\n      }\n    }\n    return output;\n  }\n\n  if (isObject(value)) {\n    for (const key of Object.keys(value)) {\n      output += `\\n${indent}${formatHeading(key)}\\n`;\n      output += formatValue(value[key], indentationLevel + 1);\n    }\n    return output;\n  }\n\n  if (value !== null && value !== undefined) {\n    output += `${indent}${value}\\n`;\n  }\n\n  return output;\n}\n\n\n// ---------- Input ----------\nconst jobId = $('Is Payload Valid?').first().json.id;\nconst jobTitle = $('Is Payload Valid?').first().json.job_title;\nconst companyName = $('Is Payload Valid?').first().json.company_name;\nconst extractorOutput = $input.first().json;\n\n// ---------- Build Document ----------\n\nconst header =\n`JOB SNAPSHOT\n----------------------------------------\nJOB TITLE: ${jobTitle}\nCOMPANY: ${companyName}\nJOB ID: ${jobId}\n----------------------------------------\\n`;\n\nconst content = header + formatValue(extractorOutput);\n\n// ---------- Output ----------\n\nreturn [\n  {\n    json: {\n      job_id: jobId,\n      file_type: \"job_info\",\n      file_name: `Job_Info.txt`,\n      content\n    }\n  }\n];"
      },
