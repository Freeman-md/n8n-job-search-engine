    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "<configure-in-your-instance>",
          "mode": "list",
          "cachedResultName": "job-engine-actions"
        },
        "messageType": "block",
        "blocksUi": "={{\n(() => {\n  const score = Number($json[\"Overall Fit Score\"]);\n  let label = \"⚪ Low-Fit Job\";\n\n  if (score >= 0.8) label = \"🔥 High-Fit Job\";\n  else if (score >= 0.6) label = \"🟡 Medium-Fit Job\";\n\n  const company = Array.isArray($json[\"Company Name\"])\n    ? $json[\"Company Name\"][0]\n    : $json[\"Company Name\"];\n\n  return {\n    blocks: [\n      {\n        type: \"section\",\n        text: {\n          type: \"mrkdwn\",\n          text:\n            `${label} (${score.toFixed(2)})\\n\\n` +\n            `*Role:* ${$json[\"Title\"]}\\n` +\n            `*Company:* ${company}\\n` +\n            `*Location:* ${$json[\"Location\"]}\\n` +\n            `*Visa Risk:* ${$json[\"Visa Risk\"]}\\n` +\n            `*Application Type:* ${$json[\"Application Type\"]}`\n        }\n      },\n      { type: \"divider\" },\n      {\n        type: \"section\",\n        text: {\n          type: \"mrkdwn\",\n          text: \"*Quick Links*\"\n        }\n      },\n      {\n        type: \"actions\",\n        elements: [\n          {\n            type: \"button\",\n            text: {\n              type: \"plain_text\",\n              text: \"Apply\",\n              emoji: true\n            },\n            url: $json[\"Job Link\"],\n            style: \"primary\",\n            value: \"apply_job\"\n          },\n          {\n            type: \"button\",\n            text: {\n              type: \"plain_text\",\n              text: \"View CV\",\n              emoji: true\n            },\n            url: $json[\"cv_link\"],\n            value: \"view_cv\"\n          },\n          {\n            type: \"button\",\n            text: {\n              type: \"plain_text\",\n              text: \"View Cover Letter\",\n              emoji: true\n            },\n            url: $json[\"cover_letter_link\"],\n            value: \"view_cover_letter\"\n          }\n        ]\n      }\n    ]\n  };\n})()\n}}",
        "text": "={{ (() => {\n  const score = Number($json[\"Overall Fit Score\"]);\n  let label = \"⚪ Low-Fit Job\";\n\n  if (score >= 0.8) label = \"🔥 High-Fit Job\";\n  else if (score >= 0.6) label = \"🟡 Medium-Fit Job\";\n\n  const title = $json[\"Title\"] || \"Unknown Role\";\n  const location = ($json[\"Location\"] || \"\").split(\",\")[0];\n\n  return `${label} (${score.toFixed(2)}) — ${title} | ${location}`;\n})() }}",
        "otherOptions": {}
      },
