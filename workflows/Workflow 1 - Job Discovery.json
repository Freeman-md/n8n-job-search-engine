      "parameters": {
        "jsCode": "const profiles = $input.all();\nconst today = $('Trigger – Weekday Run').first().json[\"Day of week\"];\n\n// Map weekdays to index 0-4\nconst dayMap = {\n  \"Monday\": 0,\n  \"Tuesday\": 1,\n  \"Wednesday\": 2,\n  \"Thursday\": 3,\n  \"Friday\": 4,\n  \"Saturday\": 1,\n  \"Sunday\": 0\n};\n\nconst index = dayMap[today] % profiles.length;\n\nreturn [profiles[index]];"
      },
