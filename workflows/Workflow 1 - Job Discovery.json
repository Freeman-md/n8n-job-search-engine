    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Extract job_id from URL - handles multiple URL formats\nfunction extractJobId(url) {\n  if (!url) return null;\n  \n  // Match the numeric ID at the end of the job view path\n  const match = url.match(/jobs\\/view\\/[^?]*?-(\\d+)(?:[?\\/]|$)/);\n  return match ? match[1] : null;\n}\n\n// Step 1: Attach job_id to each item\nconst withIds = items.map(item => {\n  item.json.job_id = extractJobId(item.json.linkedinUrl);\n  return item;\n});\n\n// Step 2: Deduplicate — keep FIRST occurrence of each job_id\nconst seen = new Map();\n\nfor (const item of withIds) {\n  const id = item.json.job_id;\n  \n  // Fallback key for items with no extractable ID: use full URL stripped of query params\n  const key = id ?? (item.json.linkedinUrl?.split('?')[0] ?? JSON.stringify(item.json));\n  \n  if (!seen.has(key)) {\n    seen.set(key, item);\n  }\n}\n\nreturn Array.from(seen.values());"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
