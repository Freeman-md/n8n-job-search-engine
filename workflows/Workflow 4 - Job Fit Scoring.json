    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"overall_fit_score\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"skill_alignment_score\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"visa_risk\": {\n      \"type\": \"string\",\n      \"enum\": [\"none\", \"moderate\", \"high\", \"unclear\"]\n    },\n    \"visa_block\": {\n      \"type\": \"boolean\"\n    },\n    \"scoring_reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"overall_fit_score\",\n    \"skill_alignment_score\",\n    \"visa_risk\",\n    \"visa_block\",\n    \"scoring_reason\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        944,
        176
      ],
      "id": "c8b036f2-d043-406a-b1f6-7436425cfc6f",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ff1c4c44-5c59-4e61-bd41-743180faa72c",
              "name": "job_status",
              "value": "={{\n  $json.output.visa_block\n    ? \"REJECTED\"\n    : (\n        !$json.output.visa_block &&\n        (\n          $json.output.skill_alignment_score >= 0.55\n          ||\n          (\n            $json.output.overall_fit_score >= 0.6 &&\n            $json.output.skill_alignment_score >= 0.45\n          )\n        )\n      )\n        ? \"SCORED\"\n        : \"REJECTED\"\n}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
