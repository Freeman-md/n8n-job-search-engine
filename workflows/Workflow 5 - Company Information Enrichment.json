    {
      "parameters": {
        "jsCode": "// ---------- Input ----------\nconst jobId = $('Validate Inputs').first().json.job_id;\nconst jobTitle = $('Validate Inputs').first().json.job_title;\nconst companyName = $('Validate Inputs').first().json.company_name;\n\nconst data = $input.first().json;\n\n// ---------- Helpers ----------\n\nfunction section(title) {\n  return `\\n${title}\\n${\"-\".repeat(title.length)}\\n`;\n}\n\nfunction list(arr) {\n  if (!arr || !Array.isArray(arr) || arr.length === 0) return \"Not available\\n\";\n  return arr.map(item => `- ${item}`).join(\"\\n\") + \"\\n\";\n}\n\nfunction value(v) {\n  return v ? `${v}\\n` : \"Not available\\n\";\n}\n\n// ---------- Build Document ----------\n\nlet content = \n`COMPANY INTELLIGENCE SNAPSHOT\n----------------------------------------\nCOMPANY: ${companyName}\nRELATED JOB: ${jobTitle}\nJOB ID: ${jobId}\n----------------------------------------\\n`;\n\n// Overview\ncontent += section(\"OVERVIEW\");\ncontent += `Description:\\n${value(data.overview?.description)}\\n`;\ncontent += `Core Products / Services:\\n${list(data.overview?.core_products_or_services)}\\n`;\ncontent += `Business Model:\\n${value(data.overview?.business_model)}\\n`;\ncontent += `Headquarters:\\n${value(data.overview?.headquarters)}\\n`;\ncontent += `Company Size:\\n${value(data.overview?.company_size)}\\n`;\ncontent += `Mission / Positioning:\\n${value(data.overview?.mission_or_positioning)}\\n`;\n\n// Market Context\ncontent += section(\"MARKET CONTEXT\");\ncontent += `Industry:\\n${value(data.market_context?.industry)}\\n`;\ncontent += `Primary Competitors:\\n${list(data.market_context?.primary_competitors)}\\n`;\ncontent += `Market Positioning:\\n${value(data.market_context?.market_positioning)}\\n`;\ncontent += `Relevant Industry Trends:\\n${list(data.market_context?.relevant_industry_trends)}\\n`;\n\n// Recent Highlights\ncontent += section(\"RECENT HIGHLIGHTS\");\ncontent += data.recent_highlights && data.recent_highlights.length\n  ? data.recent_highlights.map(h =>\n      `- ${h.headline}\\n  ${h.summary}\\n  Source: ${h.source}`\n    ).join(\"\\n\\n\") + \"\\n\"\n  : \"Not available\\n\";\n\n// Culture\ncontent += section(\"CULTURE SUMMARY\");\ncontent += `Work Style:\\n${value(data.culture_summary?.work_style)}\\n`;\ncontent += `Stated Values / Principles:\\n${list(data.culture_summary?.stated_values_or_principles)}\\n`;\n\n// Strategic Talking Points\ncontent += section(\"STRATEGIC TALKING POINTS\");\ncontent += list(data.strategic_talking_points);\n\n// Sources\ncontent += section(\"SOURCES\");\ncontent += list(data.sources);\n\n// ---------- Output ----------\n\nreturn [\n  {\n    json: {\n      job_id: jobId,\n      file_type: \"company_info\",\n      file_name: `Company_Info.txt`,\n      content\n    }\n  }\n];"
      },
