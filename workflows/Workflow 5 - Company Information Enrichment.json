        "jsCode": "const errors = [];\n\nconst item = $input.first().json;\n\nif (item.status !== \"SCORED\") {\n  errors.push(\"Job Status must be SCORED\");\n}\n\nif (!item.company_id) {\n  errors.push(\"Missing company_id\");\n}\n\nif (!item.job_folder_id) {\n  errors.push(\"Missing job_folder_id\");\n}\n\nif (errors.length > 0) {\n  throw new Error(`Validation Failed: ${errors.join(\" | \")}`);\n}\n\nreturn $input.first();"
